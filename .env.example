# BodalAI Service Configuration
# Copy this file to .env and customize as needed
# All settings are optional - defaults shown below

# ============================================================
# Server Configuration
# ============================================================
BODAL_HOST=127.0.0.1
BODAL_PORT=8000
BODAL_DEBUG=true

# ============================================================
# Path Configuration
# ============================================================
# Artifacts: where rendered videos and outputs are stored
BODAL_ARTIFACTS_ROOT=artifacts

# Jobs: where job state is persisted as JSON
BODAL_JOBS_ROOT=data/jobs

# Logs: where service logs are written
BODAL_LOGS_ROOT=logs

# Schema: path to TRP JSON schema for validation
BODAL_SCHEMA_PATH=schemas/trp.schema.json

# Orchestrator: path to orchestrator.py script
BODAL_ORCHESTRATOR=runtime/orchestrator.py

# ============================================================
# Runtime Configuration
# ============================================================
# Concurrency: number of worker threads (Phase-1 uses 1)
BODAL_CONCURRENCY=1

# Logo: default watermark logo path
BODAL_LOGO_DEFAULT=config/watermark.png

# ============================================================
# Usage Examples
# ============================================================
# Development (use defaults):
#   python -m services.api.app
#
# Custom port:
#   BODAL_PORT=8080 python -m services.api.app
#
# Production mode:
#   BODAL_HOST=0.0.0.0
#   BODAL_PORT=5000
#   BODAL_DEBUG=false
#   BODAL_CONCURRENCY=4
#   python -m services.api.app
#
# Custom artifact storage:
#   BODAL_ARTIFACTS_ROOT=/mnt/storage/artifacts
#   python -m services.api.app
